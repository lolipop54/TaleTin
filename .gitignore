#.vscode/
.idea/
# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

android/key.properties                 你的签名配置，包含密码
android/app/gtreader-release.jks        你的正式签名密钥
android/local.properties               本机 SDK 路径
android/.gradle/
android/.kotlin/
android/build/

# Widget Preview related
.widget_preview/


# Gradle 的根项目构建目录（只有问题报告等产物）
/android/build/

# 本地插件的 Gradle 缓存与构建报告
/third_party/flutter_inappwebview_android/android/.gradle/
